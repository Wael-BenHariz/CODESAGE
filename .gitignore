# ============================================
# .gitignore
# ============================================

# Dependencies
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/
dist/
build/

# Build outputs
.next/
out/
.nuxt/
.swc/
.cache/
frontend/.angular/
frontend/node_modules/

# Docker
.docker/

# Environment files
.env
.env.local
.env.*.local
.env.docker
.env.*.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test
coverage/
.nyc_output/
*.lcov
.pytest_cache/
__pycache__/

# Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Kubernetes
kubeconfig
*.kubeconfig

# CI/CD
.github/workflows/*.yml
!.github/workflows/ci-cd.yaml

# Secrets
*.pem
*.key
*.crt
secrets.env
# Filled backend k8s secret (real credentials) — commit only secret.example.yaml
infrastructure/k8s/base/backend/secret.yaml
# Filled keycloak k8s secret (admin + client secrets) — commit only the template
infrastructure/k8s/base/keycloak/keycloak-secret.yaml
!infrastructure/k8s/base/keycloak/keycloak-secret.example.yaml

# Temporary
tmp/
temp/
*.tmp

# OS
Thumbs.db
.DS_Store

# Executables
ngrok.exe

# Virtual environments
venv/
.env/

# Opencode config
.opencode/
opencode.json

# Local Redis runtime artifacts
dump.rdb
server_log.txt