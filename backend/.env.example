# Environment Template
# Copy this file to .env and fill in your values

# Application
APP_NAME=CodeSage
APP_VERSION=1.0.0
DEBUG=false
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Security - CHANGE THIS IN PRODUCTION!
SECRET_KEY=your-super-secret-key-at-least-32-characters-long

# JWT Token Settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
# Single-use OAuth state TTL in Redis (seconds) — CSRF protection for the login flow
OAUTH_STATE_TTL_SECONDS=600
# Refresh-token rotation via a per-user Redis jti allow-list.
# Set to false to kill the switch (plain re-issue, no jti check).
AUTH_REFRESH_ROTATION=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://codesage:codesage@postgres:5432/codesage
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://redis:6379/0

# GitHub OAuth App
# Create at: https://github.com/settings/applications/new
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback
FRONTEND_URL=http://localhost:4200

# GitHub App (for webhook integration)
# Create at: https://github.com/settings/apps
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_SLUG=codesage-ai-bot
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
your-private-key-content
-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your-webhook-secret
STATE_TOKEN_SECRET=your-state-token-secret

# Groq (active review LLM)
# Get API key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Per-user LLM API key encryption (Fernet). REQUIRED — startup fails without it.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_ENCRYPTION_KEY=

# Keycloak — identity/token authority (GitHub login goes through its broker)
# In-cluster URL for server-side JWKS fetch; browser uses the public URL.
KEYCLOAK_URL=http://keycloak-service.codesage.svc.cluster.local:8080
KEYCLOAK_PUBLIC_URL=http://localhost:4200/auth
KEYCLOAK_REALM=codesage-realm
KEYCLOAK_CLIENT_ID=codesage-backend
KEYCLOAK_CLIENT_SECRET=your-keycloak-backend-client-secret
# Access-token audience check: azp (or aud) must equal the SPA client id
KEYCLOAK_AUDIENCE=codesage-angular

# SonarQube (static analysis engine for the review pipeline)
SONARQUBE_URL=http://sonarqube-sonarqube.sonarqube.svc.cluster.local:9000
SONARQUBE_TOKEN=your_sonarqube_token_here
SONARQUBE_ANALYSIS_TIMEOUT=120
SONARQUBE_POLL_INTERVAL=3
SONARQUBE_PROJECT_PREFIX=codesage-review

# Google Gemini (legacy client, still required by config)
# Get API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.7

# BullMQ Worker
BULLMQ_REVIEW_QUEUE=review-requests
BULLMQ_CONCURRENCY=5

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
